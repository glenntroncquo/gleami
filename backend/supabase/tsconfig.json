{
    "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "lib": ["ES2022"],
      "outDir": "./dist",
      "rootDir": "./",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"],
        "@tests/*": ["tests/*"]
      },
      "types": ["node"]
    },
    "include": [
      "src/**/*",
      "tests/**/*",
      "supabase/functions/**/*",
      "scripts/**/*"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "coverage"
    ]
  }