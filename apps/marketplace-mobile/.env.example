# Public Supabase client. The anon key is meant to ship in the app.
# Required unless EXPO_PUBLIC_USE_MOCKS=1.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Example salons around Brussels, Ghent and Antwerp. No backend required.
EXPO_PUBLIC_USE_MOCKS=1

# Mapbox public runtime token. Leave empty to show the map placeholder.
# There is no download token (deprecated).
EXPO_PUBLIC_MAPBOX_TOKEN=

# Public booking site. Defaults to https://booking.salonify.co.
EXPO_PUBLIC_BOOKING_WEB_URL=https://booking.salonify.co

# Google Sign-In OAuth client IDs (Google Cloud → Credentials). Public values.
# The web client ID is the one configured on the Supabase Google provider; it is
# the audience of the ID token. The iOS client ID also drives the URL scheme in
# app.config.ts, so rebuild the dev client after setting it. Leave empty to hide
# the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
